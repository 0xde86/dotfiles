{
  "position": "top",
  // Inset the bar from the screen edges to match Hyprland's gaps_out (4px).
  // Bottom is 0 — the gap to the windows below is provided by gaps_out.
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "margin-bottom": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["hyprland/language", "bluetooth", "pulseaudio", "battery", "network", "clock", "power-profiles-daemon"],
  // format-<lang> keys match {shortDescription} ("en", "ru"), not the layout
  // short name ("us"). Once one of them matches, "format" gets the matched
  // string as the positional {} and named fields ({shortDescription}, {long},
  // ...) are NOT bound -- using one there makes waybar 0.15 disable the whole
  // module with "argument not found".
  // Without "keyboard-name" the module follows every keyboard; set it (see
  // `hyprctl devices`) to pin it to one.
  "hyprland/language": {
    "format": "<span size='13000' foreground='#c6d0f5'>󰌌</span>  {}",
    "format-en": "EN",
    "format-ru": "RU",
    "tooltip-format": "{long}",
    "on-click": "hyprctl switchxkblayout current next"
  },
  "clock": {
    "format": "<span></span>  {:%a %d  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='13000' foreground='#a6e3a1'>{icon}</span>  {capacity}%",
    "format-warning": "<span size='13000' foreground='#B1E3AD'>{icon}</span>  {capacity}%",
    "format-critical": "<span size='13000' foreground='#E38C8F'>{icon}</span>  {capacity}%",
    "format-charging": "<span size='13000' foreground='#B1E3AD'></span>  {capacity}%",
    "format-plugged": "<span size='13000' foreground='#B1E3AD'></span>  {capacity}%",
    "format-alt": "<span size='13000' foreground='#B1E3AD'>{icon}</span>  {time}",
    "format-full": "<span size='13000' foreground='#B1E3AD'></span>  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}",
    "on-click": "kitty --override confirm_os_window_close=0 --title 'System Monitor' btop",
    "on-click-right": "kitty --override confirm_os_window_close=0 --title Battery -- /bin/sh -c 'upower -i /org/freedesktop/UPower/devices/battery_BAT1; echo; echo Press Enter to close...; read -r line'"
  },
  "network": {
    "format-wifi": "<span size='13000' foreground='#f5e0dc'></span>  {signalStrength}%",
    "tooltip-format-wifi": "Net: {essid}",
    "format-ethernet": "<span size='13000' foreground='#f5e0dc'>󰤭</span>  Disconnected",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "<span size='13000' foreground='#f5e0dc'></span>  Disconnected",
    "on-click-right": "cosmic-settings network",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
      "format": "{icon}  {volume}%",
      "format-muted": "",
      "format-icons": {
          "default": ["", "", ""]
      },
      "on-click-right": "cosmic-settings sound",
      "on-click": "pavucontrol"
  },
  "bluetooth": {
		"format": "",
		"format-connected": "󰂱",
		"format-off": "󰂲",
		"format-disabled": "󰂲",
		"tooltip-format": "{status}",
		"on-click": "blueman-manager",
    "on-click-right": "cosmic-settings bluetooth",
		"tooltip-format-connected": "Bluetooth: {device_alias}"
	},
  // "cpu": {
  //   "interval": 30,
  //   "format":"  {usage}%",
  //   "cursor": true,
  //   "states": {
  //       "warning": 80,
  //       "critical": 90
  //   }
  // },
  "power-profiles-daemon": {
    "format": "{icon} ",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
        "performance": "",
        "balanced": "",
        "power-saver": ""
    }
  }
}
