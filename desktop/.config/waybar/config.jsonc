{
  "position": "top",
  // Inset the bar from the screen edges to match Hyprland's gaps_out (4px).
  // Bottom is 0 — the gap to the windows below is provided by gaps_out.
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "margin-bottom": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["temperature#cpu", "temperature#gpu", "hyprland/language", "bluetooth", "pulseaudio", "battery", "network", "clock", "power-profiles-daemon"],
  "hyprland/language": {
    "format": "<span size='13000' rise='-1024' foreground='#c6d0f5'>󰌌</span>  {}",
    "format-en": "EN",
    "format-ru": "RU",
    "tooltip-format": "{long}",
    "on-click": "hyprctl switchxkblayout current next"
  },
  "clock": {
    "format": "<span></span>  {:%a %d  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='13000' foreground='#a6e3a1'>{icon}</span>  {capacity}%",
    "format-warning": "<span size='13000' foreground='#B1E3AD'>{icon}</span>  {capacity}%",
    "format-critical": "<span size='13000' foreground='#E38C8F'>{icon}</span>  {capacity}%",
    "format-charging": "<span size='13000' foreground='#B1E3AD'></span>  {capacity}%",
    "format-plugged": "<span size='13000' foreground='#B1E3AD'></span>  {capacity}%",
    "format-alt": "<span size='13000' foreground='#B1E3AD'>{icon}</span>  {time}",
    "format-full": "<span size='13000' foreground='#B1E3AD'></span>  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}",
    "on-click": "kitty --override confirm_os_window_close=0 --title 'System Monitor' btop",
    "on-click-right": "kitty --override confirm_os_window_close=0 --title Battery -- /bin/sh -c 'upower -i /org/freedesktop/UPower/devices/battery_BAT1; echo; echo Press Enter to close...; read -r line'"
  },
  "network": {
    "format-wifi": "<span size='13000' foreground='#f5e0dc'></span>  {signalStrength}%",
    "tooltip-format-wifi": "Net: {essid}",
    "format-ethernet": "<span size='13000' foreground='#f5e0dc'>󰤭</span>  Disconnected",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "<span size='13000' foreground='#f5e0dc'></span>  Disconnected",
    "on-click-right": "kitty --override confirm_os_window_close=0 -e nmtui",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
      "format": "{icon}  {volume}%",
      "format-muted": "",
      "format-icons": {
          "default": ["", "", ""]
      },
      "on-click-right": "pavucontrol",
      "on-click": "pavucontrol"
  },
  "bluetooth": {
		"format": "",
		"format-connected": "󰂱",
		"format-off": "󰂲",
		"format-disabled": "󰂲",
		"tooltip-format": "{status}",
		"on-click": "blueman-manager",
    "on-click-right": "blueman-adapters",
		"tooltip-format-connected": "Bluetooth: {device_alias}"
	},
  "temperature#cpu": {
    "hwmon-path-abs": "/sys/devices/platform/PNP0C14:08/wmi_bus/wmi_bus-PNP0C14:08/A70591CE-A997-11DA-B012-B622A1EF5492-24/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 90,
    "format": "<span size='13000'>\uF2DB</span>  {temperatureC}°",
    "format-critical": "<span size='13000' foreground='#e78284'>󰻠</span>  {temperatureC}°",
    "tooltip-format": "CPU {temperatureC}°C",
    "on-click": "kitty --override confirm_os_window_close=0 --title 'System Monitor' btop"
  },
  "temperature#gpu": {
    "hwmon-path-abs": "/sys/devices/platform/PNP0C14:08/wmi_bus/wmi_bus-PNP0C14:08/A70591CE-A997-11DA-B012-B622A1EF5492-24/hwmon",
    "input-filename": "temp2_input",
    "interval": 5,
    "critical-threshold": 85,
    "format": "<span size='13000'>󰢮</span>  {temperatureC}°",
    "format-critical": "<span size='13000' foreground='#e78284'>󰢮</span>  {temperatureC}°",
    "tooltip-format": "GPU {temperatureC}°C",
    "on-click": "kitty --override confirm_os_window_close=0 --title 'System Monitor' btop"
  },
  // "cpu": {
  //   "interval": 30,
  //   "format":"  {usage}%",
  //   "cursor": true,
  //   "states": {
  //       "warning": 80,
  //       "critical": 90
  //   }
  // },
  "power-profiles-daemon": {
    "format": "{icon} ",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
        "performance": "",
        "balanced": "",
        "power-saver": ""
    }
  }
}
